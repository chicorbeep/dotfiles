// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "git": {
    "branch_picker": {
      "show_author_name": true
    },
    "inline_blame": {
      "show_commit_summary": true,
      "padding": 8
    }
  },
  "collaboration_panel": {
    "button": false,
    "dock": "right"
  },
  "git_panel": {
    "status_style": "icon",
    "tree_view": false
  },
  "tab_bar": {
    "show_pinned_tabs_in_separate_row": false,
    "show": true
  },
  "tabs": {
    "file_icons": true,
    "git_status": true
  },
  "title_bar": {
    "show_menus": true,
    "show_user_picture": true,
    "show_sign_in": false,
    "show_branch_icon": true
  },
  "status_bar": {
    "cursor_position_button": true,
    "active_encoding_button": "enabled"
  },
  "project_panel": {
    "hide_hidden": false,
    "bold_folder_labels": true,
    "button": true
  },
  "languages": {
    "JSON": {
      "tab_size": 4
    }
  },
  "message_editor": {
    "auto_replace_emoji_shortcode": true
  },
  "colorize_brackets": true,
  "toolbar": {
    "agent_review": false
  },
  "which_key": {
    "enabled": true
  },
  "rounded_selection": false,
  "hard_tabs": true,
  "agent_ui_font_size": 6.0,
  "agent_buffer_font_size": 14.0,
  "ui_font_family": "IBM Plex Mono",
  "ui_font_weight": 400.0,
  "helix_mode": true,
  "disable_ai": true,
  "vim_mode": false,
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "font_weight": 200.0,
    "font_family": "CozetteVector",
    "shell": "system",
    "button": true,
    "font_size": 13.0,
    "line_height": {"custom": 1}
  },
  "base_keymap": "VSCode",
  "agent": {
    "enabled": false,
    "button": false,
    "favorite_models": [],
    "model_parameters": [],
  },
  "buffer_line_height": "comfortable",
  "autosave": "on_focus_change",
  "buffer_font_fallbacks": ["Adwaita Sans", "monospace"],
  "buffer_font_family": "IBM Plex Mono",
  "ui_font_size": 16.0,
	"buffer_font_size": 13.0,
  "theme": "Gruvbox Dark Hard",
  "text_rendering_mode": "grayscale",
  "format_on_save": "off",

}
